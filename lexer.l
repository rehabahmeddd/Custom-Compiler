%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include "y.tab.h" // Include the parser header file generated by Bison


void yyerror(const char *s);


int line_number = 1;
%}




%option noyywrap

/* Regular Definitions */
DIGIT       [0-9]
LETTER      [a-zA-Z]
ID          {LETTER}({LETTER}|{DIGIT})*
INT         {DIGIT}+ 
FLOAT       {DIGIT}+\.{DIGIT}+ 
WHITESPACE  [ \t]+
NEWLINE     \n
CARRIAGERET  [\r]+
COMMENT     \/\/.*
MULTILINE_COMMENT \/[*]([^*]|[*][^/])*[*]\/
DOUBLE      {DIGIT}+\.{DIGIT}+[eE][+-]?{DIGIT}+

%%

"if"        { return IF; }
"else"      { return ELSE; }
"while"     { return WHILE; }
"do"        { return DO; }
"for"       { return FOR; }
"switch"    { return SWITCH; }
"case"      { return CASE; }
"default"   { return DEFAULT; }
"break"     { return BREAK; }
"continue"  { return CONTINUE; }
"return"    { return RETURN; }
"const"     { return CONST; }

"int"       { return INT_TYPE; }
"float"     { return FLOAT_TYPE; }
"double"    { return DOUBLE_TYPE; }
"string"    { return STRING_TYPE; }
"char"      { return CHAR_TYPE; }
"void"      { return VOID_TYPE; }
"bool"      { return BOOL_TYPE; }

"true"      { yylval.bval = true; return BOOL; }
"false"     { yylval.bval = false; return BOOL; }

"="         { return ASSIGN; }
"+"         { return ADD; }
"-"         { return SUB; }
"*"         { return MUL; }
"/"         { return DIV; }
"%"         { return MOD; }

"<"         { return LT; }
">"         { return GT; }
"=="        { return EQ; }
"!="        { return NEQ; }
"<="        { return LE; }
">="        { return GE; }

"&&"        { return AND; }
"||"        { return OR; }
"!"         { return NOT; }

"("         { return LPAREN; }
")"         { return RPAREN; }
"{"         { return LBRACE; }
"}"         { return RBRACE; }
";"         { return SEMICOLON; }
","         { return COMMA; }
":"         { return COLON; }

{ID}        { 
              yylval.sval = strdup(yytext);  
              return ID; 
            }

{INT}       { 
              yylval.ival = atoi(yytext); 
              return INT; 
            }

{FLOAT}     { 
              yylval.fval = atof(yytext); 
              return FLOAT; 
            }

{DOUBLE}    { 
              yylval.fval = atof(yytext); 
              return DOUBLE; 
            }

 /* strings */
\"[^\"]*\"  { 
              yylval.sval = strdup(yytext); 
              return STRING; 
            }
 /* characters */
\'[^\']\'   { 
              yylval.sval = strdup(yytext); 
              return CHAR; 
            }


{WHITESPACE} { /* Ignore whitespace */ }
{CARRIAGERET} { /* Ignore spaces and tabs and carriage return */ }
{NEWLINE}    { line_number++; }
{COMMENT}    { /* Ignore comments */ }
{MULTILINE_COMMENT} { /* Ignore multiline comments */ }

.           { 
              char error_msg[100];
              sprintf(error_msg, " Unrecognized character: %s at line %d", yytext, line_number);
              yyerror(error_msg); 
            }

{DIGIT}({LETTER}|{DIGIT})*  { 
            char error_msg[100];
            sprintf(error_msg, "Invalid identifier: %s at line %d", yytext, line_number);
            yyerror(error_msg); 
          }

%%

/* Additional C code can go here if needed */